# =============================================================================
# KSTC E-Commerce Platform — Environment Configuration Template
# =============================================================================
# Copy this file to `.env` and fill in your real credentials.
# NEVER commit the `.env` file to version control.
# =============================================================================

# -----------------------------------------------------------------------------
# DATABASE CONNECTION (PostgreSQL)
# -----------------------------------------------------------------------------
# Prisma connection string for PostgreSQL (Supabase, Neon, or local PostgreSQL).
# Format: postgresql://[user]:[password]@[host]:[port]/[database]?pgbouncer=true
DATABASE_URL="postgresql://postgres:[YOUR-DB-PASSWORD]@[YOUR-HOST].supabase.com:5432/postgres"

# -----------------------------------------------------------------------------
# EMAIL SMTP CONFIGURATION (Nodemailer)
# -----------------------------------------------------------------------------
# Used for dispatching 6-digit OTP verification codes during user login/signup.
# If these variables are not provided, the application runs in dev fallback mode
# and prints generated OTPs directly to the terminal console.
#
# For Gmail:
#   1. Enable 2-Step Verification on your Google Account: https://myaccount.google.com/signinoptions/two-step-verification
#   2. Generate an "App Password": https://myaccount.google.com/apppasswords
#   3. Enter your Gmail and the 16-character App Password below.
SMTP_HOST="smtp.gmail.com"
SMTP_PORT="465"
SMTP_USER="your-email@gmail.com"
SMTP_PASS="your-16-char-app-password"
SMTP_FROM="Khatu Shyam Trading Co. <your-email@gmail.com>"

# -----------------------------------------------------------------------------
# AUTHENTICATION SECRET
# -----------------------------------------------------------------------------
# Secret key used by Jose to sign and verify HS256 JWT session cookies.
# Generate a secure 32+ character random string using:
#   Linux/macOS/Git Bash: openssl rand -base64 32
#   PowerShell: [Convert]::ToBase64String((1..32 | ForEach-Object { Get-Random -Minimum 0 -Maximum 256 } -as [byte[]]))
AUTH_SECRET="replace-with-a-secure-random-32-character-secret-key"
