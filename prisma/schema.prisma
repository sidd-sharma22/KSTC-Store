generator client {
  provider = "prisma-client-js"
  engineType = "library"
}

datasource db {
  provider = "postgresql"
}

// -----------------------------------------------------------------------------
// ENUMS
// -----------------------------------------------------------------------------

enum Role {
  RETAIL_CUSTOMER
  CONTRACTOR
  AUTHORIZED_DEALER
  PLUMBER
  ADMIN_SUPER
  ADMIN_SALES
  ADMIN_BILLING
  STAFF_WAREHOUSE
  // Legacy roles for backward compatibility with existing session/user data
  RETAIL
  TRADE
  ADMIN
}

enum TradeStatus {
  PENDING
  APPROVED
  REJECTED
}

enum AddressType {
  BILLING
  SHIPPING
}

enum OrderStatus {
  PENDING
  CONFIRMED
  SHIPPED
  DELIVERED
  CANCELLED
}

enum PaymentMethod {
  CASHFREE
  PAY_LATER
  BANK_TRANSFER
  RAZORPAY
  COD
}

enum PaymentStatus {
  PENDING
  COMPLETED
  FAILED
  REFUNDED
}

enum DeliveryType {
  DELIVERY
  PICKUP
}

enum QuoteStatus {
  OPEN
  RESPONDED
  CONVERTED
  REJECTED
}

enum DiscountType {
  PERCENTAGE
  FIXED_AMOUNT
}

enum PayoutStatus {
  REQUESTED
  PROCESSING
  PAID
  REJECTED
}

// -----------------------------------------------------------------------------
// USER & PROFILE MODELS
// -----------------------------------------------------------------------------

model User {
  id                    String          @id @default(cuid())
  name                  String?
  email                 String?         @unique
  emailVerified         DateTime?
  passwordHash          String?
  phone                 String?         @unique
  
  role                  Role            @default(RETAIL_CUSTOMER)
  
  // Tag to distinguish Normal Customers vs Contractors (e.g. "HOMEOWNER", "BUILDER", "CONTRACTOR")
  customerTag           String?
  companyName           String?
  
  // Authorized Dealer / Trade Specific Fields
  shopName              String?
  gstNumber             String?
  tradeStatus           TradeStatus?
  creditLimit           Float?          @default(0)
  usedCredit            Float?          @default(0)
  
  // Referral tracking
  referredByPlumberCode String?
  
  createdAt             DateTime        @default(now())
  updatedAt             DateTime        @updatedAt

  addresses             Address[]
  orders                Order[]
  quotes                Quote[]
  plumberProfile        PlumberProfile?
}

model PlumberProfile {
  id                String                @id @default(cuid())
  userId            String                @unique
  user              User                  @relation(fields: [userId], references: [id], onDelete: Cascade)
  plumberCode       String                @unique // e.g. "PLUM-7840" or mobile number
  totalPoints       Float                 @default(0)
  redeemedPoints    Float                 @default(0)
  activePoints      Float                 @default(0)
  commissionRate    Float                 @default(0.05) // 5% default referral commission
  upiId             String?
  bankAccountNumber String?
  bankIfsc          String?
  bankAccountName   String?
  
  referrals         ReferralTransaction[]
  payoutRequests    PayoutRequest[]
  
  createdAt         DateTime              @default(now())
  updatedAt         DateTime              @updatedAt
}

model ReferralTransaction {
  id             String         @id @default(cuid())
  plumberId      String
  plumber        PlumberProfile @relation(fields: [plumberId], references: [id], onDelete: Cascade)
  orderId        String         @unique
  order          Order          @relation(fields: [orderId], references: [id])
  orderAmount    Float
  commissionRate Float          @default(0.05)
  pointsEarned   Float
  status         PaymentStatus  @default(PENDING)
  createdAt      DateTime       @default(now())
}

model PayoutRequest {
  id                 String         @id @default(cuid())
  plumberId          String
  plumber            PlumberProfile @relation(fields: [plumberId], references: [id], onDelete: Cascade)
  pointsRedeemed     Float
  cashAmount         Float          // 1 Point = 1 INR
  payoutStatus       PayoutStatus   @default(REQUESTED)
  cashfreeTransferId String?
  utrNumber          String?
  adminNotes         String?
  processedAt        DateTime?
  createdAt          DateTime       @default(now())
  updatedAt          DateTime       @updatedAt
}

model Coupon {
  id            String       @id @default(cuid())
  code          String       @unique
  description   String?
  discountType  DiscountType @default(PERCENTAGE)
  discountValue Float
  minOrderValue Float        @default(0)
  maxDiscount   Float?
  validFrom     DateTime     @default(now())
  validUntil    DateTime?
  usageLimit    Int?
  usageCount    Int          @default(0)
  allowedRoles  Role[]
  isActive      Boolean      @default(true)
  orders        Order[]
  createdAt     DateTime     @default(now())
  updatedAt     DateTime     @updatedAt
}

model Address {
  id        String      @id @default(cuid())
  userId    String
  user      User        @relation(fields: [userId], references: [id], onDelete: Cascade)
  type      AddressType
  street    String
  city      String
  state     String
  pincode   String
  isDefault Boolean     @default(false)
  
  createdAt DateTime    @default(now())
  updatedAt DateTime    @updatedAt
  
  orders    Order[]     @relation("ShippingAddress")
}

// -----------------------------------------------------------------------------
// CATALOG MODELS
// -----------------------------------------------------------------------------

model Category {
  id        String     @id @default(cuid())
  name      String
  slug      String     @unique
  parentId  String?
  parent    Category?  @relation("CategoryHierarchy", fields: [parentId], references: [id])
  children  Category[] @relation("CategoryHierarchy")
  imageUrl  String?
  
  products  Product[]
}

model Product {
  id              String                 @id @default(cuid())
  sku             String                 @unique
  title           String
  slug            String                 @unique
  brand           String?
  categoryId      String
  category        Category               @relation(fields: [categoryId], references: [id])
  description     String?                @db.Text
  basePrice       Float                  // Retail MRP
  dealerPrice     Float?                 // Authorized Dealer Wholesale Price
  contractorPrice Float?                 // Contractor Discounted Price
  stockCount      Int                    @default(0)
  datasheetUrl    String?
  isActive        Boolean                @default(true)
  hsnCode         String?                @default("3917")
  gstRate         Float                  @default(18.0)
  unit            String                 @default("PCS")
  
  createdAt       DateTime               @default(now())
  updatedAt       DateTime               @updatedAt

  specifications  ProductSpecification[]
  images          ProductImage[]
  bulkPricing     BulkPricingTier[]
  orderItems      OrderItem[]
  quoteItems      QuoteItem[]
}

model ProductSpecification {
  id        String   @id @default(cuid())
  productId String
  product   Product  @relation(fields: [productId], references: [id], onDelete: Cascade)
  name      String
  value     String
}

model ProductImage {
  id        String   @id @default(cuid())
  productId String
  product   Product  @relation(fields: [productId], references: [id], onDelete: Cascade)
  url       String
  isPrimary Boolean  @default(false)
}

model BulkPricingTier {
  id           String   @id @default(cuid())
  productId    String
  product      Product  @relation(fields: [productId], references: [id], onDelete: Cascade)
  minQuantity  Int
  pricePerUnit Float
}

// -----------------------------------------------------------------------------
// COMMERCE MODELS
// -----------------------------------------------------------------------------

model Order {
  id                    String               @id @default(cuid())
  userId                String
  user                  User                 @relation(fields: [userId], references: [id])
  totalAmount           Float
  taxAmount             Float
  discountAmount        Float                @default(0)
  status                OrderStatus          @default(PENDING)
  paymentMethod         PaymentMethod
  paymentStatus         PaymentStatus        @default(PENDING)
  
  // Cashfree PG fields
  cashfreeOrderId       String?              @unique
  cashfreePaymentId     String?
  
  // Dynamic Coupons
  couponId              String?
  coupon                Coupon?              @relation(fields: [couponId], references: [id])
  
  // Plumber Referral Link
  referredByPlumberCode String?
  referralTransaction   ReferralTransaction?
  
  // Real Bill Upload & Customer Dispatch
  realBillUrl           String?              @db.Text
  realBillFilename      String?
  realBillUploadedAt    DateTime?
  realBillUploadedBy    String?

  shippingAddressId     String?
  shippingAddress       Address?             @relation("ShippingAddress", fields: [shippingAddressId], references: [id])
  
  deliveryType          DeliveryType
  
  createdAt             DateTime             @default(now())
  updatedAt             DateTime             @updatedAt

  items                 OrderItem[]
}

model OrderItem {
  id        String  @id @default(cuid())
  orderId   String
  order     Order   @relation(fields: [orderId], references: [id], onDelete: Cascade)
  productId String
  product   Product @relation(fields: [productId], references: [id])
  quantity  Int
  unitPrice Float
}

model Quote {
  id          String      @id @default(cuid())
  userId      String
  user        User        @relation(fields: [userId], references: [id])
  message     String?     @db.Text
  adminNotes  String?     @db.Text
  status      QuoteStatus @default(OPEN)
  
  createdAt   DateTime    @default(now())
  updatedAt   DateTime    @updatedAt

  items       QuoteItem[]
}

model QuoteItem {
  id                String  @id @default(cuid())
  quoteId           String
  quote             Quote   @relation(fields: [quoteId], references: [id], onDelete: Cascade)
  productId         String
  product           Product @relation(fields: [productId], references: [id])
  requestedQuantity Int
  offeredPrice      Float?
}

// -----------------------------------------------------------------------------
// OPERATIONAL MODELS & INTEGRATIONS
// -----------------------------------------------------------------------------

model StoreLocation {
  id             String  @id @default(cuid())
  name           String
  address        String  @db.Text
  contactPhone   String?
  operatingHours String?
  latitude       Float?
  longitude      Float?
}

model VerificationOtp {
  id        String   @id @default(cuid())
  email     String
  otp       String
  expiresAt DateTime
  createdAt DateTime @default(now())

  @@index([email])
}

model TallySyncLog {
  id            String   @id @default(cuid())
  batchId       String
  vouchersCount Int
  status        String   // "SUCCESS" | "FAILED"
  xmlData       String?  @db.Text
  errorMessage  String?  @db.Text
  createdAt     DateTime @default(now())
}
